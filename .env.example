# Public values bundled by Vite
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
VITE_MAPTILER_KEY=replace-with-domain-restricted-key
VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key={key}

# Server-only values
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-16-random-bytes
MONITORING_SECRET=replace-with-a-different-16-byte-secret
